MP_API_KEY=your_materials_project_api_key

# Cognee: local, offline embedding provider (no API key required).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Graph DB (embedded, file-based - no infra needed)
GRAPH_DATABASE_PROVIDER=kuzu
VECTOR_DB_PROVIDER=lancedb
DB_PROVIDER=sqlite

# Optional: enable natural-language graph search (Phase 2). OpenAI-compatible.
# LLM_API_KEY=

# Skips cognee's one-time LLM connectivity self-test at pipeline startup.
# Remove this once LLM_API_KEY is set above.
COGNEE_SKIP_CONNECTION_TEST=true
